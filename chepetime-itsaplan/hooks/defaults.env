# Package defaults, read by api, worker, bot and web before secrets.env.
# Anything in ${APP_DATA_DIR}/secrets.env overrides these.
#
# Not executable and not a hook name: nothing runs it. It sits in hooks/ only
# because that directory is refreshed on every app update.

# The address the app is reached at. API_URL is always APP_URL + /api — the
# gateway routes that path to the api (hooks/nginx.conf).
#
# This LAN default only proves the stack is up. Sessions need https: with
# NODE_ENV=production the session cookie is Secure, and browsers drop it over
# plain http, so sign-in "succeeds" and leaves you signed out. Put the https
# address (Cloudflare Tunnel or similar) in secrets.env.
APP_URL=http://umbrel.local:36263
API_URL=http://umbrel.local:36263/api

# umbrel_main_network. app_proxy, the gateway and the cloudflared connector
# all live here; skipping them from the right of X-Forwarded-For leaves the
# real client address for the sign-in rate limit.
TRUSTED_PROXIES=10.21.0.0/16

# Upstream's worker sends anonymous usage pings to telemetry.itsaplan.dev
# (TELEMETRY.md). Off by default here; TELEMETRY_DISABLED=0 in secrets.env
# turns it back on.
TELEMETRY_DISABLED=1
